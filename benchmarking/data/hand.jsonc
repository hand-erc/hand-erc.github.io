        {
          "title": "Grasping",
          "description": "",
          "benchmarks": [
            {
              "id": "grasp-taxonomy-score",
              "title": "GRASP Taxonomy Score",
              "shortDescription": "Measures the hand's mobility by measuring how many human hand grasps it can achieve.",
              "description": "The GRASP Taxonomy defined by Feix et al. [1] is the most comprehensive taxonomy of human grasp types. In this benchmark, hands are scored by how many of the grasp types in the GRASP taxonomy they can achieve. This score measures hand mobility, but is biased towards anthropomorphic designs.",
              "procedures": [""],
              "metrics": [{ "name": "", "unit": "", "description": "" }],
              "analysisMethods": [""],
              "references": ["T. Feix, J. Romero, H.-B. Schmiedmayer, A. M. Dollar, and D. Kragic, \"The GRASP Taxonomy of Human Grasp Types,\" <em>IEEE Transactions on Human-Machine Systems</em>, vol. 46, pp. 66–77, 2016."]
            },
            {
              "id": "grasping-volume",
              "title": "Grasping Volume",
              "shortDescription": "The minimum and maximum size of an object a hand can grasp.",
              "description": "Grasp volume measures the largest and smallest objects a robot hand can hold, using objects of varying size. Common geometries used for this benchmark are cylinders and spheres.",
              "procedures": [""],
              "metrics": [{ "name": "", "unit": "", "description": "" }],
              "analysisMethods": [""],
              "references": ["G. A. Kragten, C. Meijneke, and J. L. Herder, \"A proposal for benchmark tests for underactuated or compliant hands,\" <em>Mech. Sci.</em>, vol. 1, no. 1, pp. 13–18, Dec. 2010, doi: <a href='https://doi.org/10.5194/ms-1-13-2010'>10.5194/ms-1-13-2010</a>."]
            },
