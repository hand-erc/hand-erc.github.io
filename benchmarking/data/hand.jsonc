            {
              "id": "grasp-strength",
              "title": "Grasp Strength",
              "shortDescription": "The overall force production of the hand in a wrap grasp and a pinch grasp.",
              "description": "Grasp strength, as defined by NIST, measures the maximum grasp force a hand can exert using a split cylinder artifact. It can be measured in both a wrap grasp and a pinch grasp.",
