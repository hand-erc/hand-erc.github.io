    {
      "title": "Wrist",
      "description": "Each benchmark in this category can be measured for both pitch and yaw axes.",
      "benchmarks": [
        {
          "id": "wrist-passive-impedance",
          "title": "Passive Impedance",
          "shortDescription": "Measure of the hand's responsiveness to environmental disturbances.",
          "description": "Mechanical impedance is a frequency-dependent measure of a system's resistance to motion. It is defined as the ratio of force to velocity: F/V. For the wrist of a robot hand, it is measured using a dynamometer, which excites the wrist with sinusoidal motions while measuring the resulting contact force. From the data, the frequency response of the mechanical impedance is measured, and dynamic properties are extracted by fitting a model to the data. From passive impedance, the effective mass, stiffness, and damping can be extracted. The wrist's passive dynamics define the system resonance, which imposes a fundamental limitation on force control bandwidth.",
          "procedures": [""],
          "metrics": [{ "name": "", "unit": "", "description": "" }],
          "analysisMethods": [""]
        },
        {"_comment": "HIDDEN — moved to Not Currently Supported tab; remove _hidden to restore", "_hidden": true,
          "id": "wrist-durability",
          "title": "Durability",
          "shortDescription": "",
          "description": "",
          "procedures": [""],
          "metrics": [{ "name": "", "unit": "", "description": "" }],
          "analysisMethods": [""]
        },
        {"_comment": "HIDDEN — moved to Not Currently Supported tab; remove _hidden to restore", "_hidden": true,
          "id": "wrist-coupling",
          "title": "Coupling",
          "shortDescription": "",
          "description": "",
          "procedures": [""],
          "metrics": [{ "name": "", "unit": "", "description": "" }],
          "analysisMethods": [""]
        },
        {
          "id": "wrist-strength",
          "title": "Strength",
          "shortDescription": "Force production capability.",
          "description": "For the wrist, strength is measured in terms of the maximum torque it can output about the yaw and pitch axes.",
          "procedures": [""],
          "metrics": [{ "name": "", "unit": "", "description": "" }],
          "analysisMethods": [""]
        },
        {
          "id": "wrist-speed",
          "title": "Speed",
          "shortDescription": "Maximum joint speed of the wrist.",
          "description": "Wrist speed is a measure of the maximum angular speed the wrist can achieve, about both the yaw and the pitch axes.",
          "procedures": [""],
          "metrics": [{ "name": "", "unit": "", "description": "" }],
          "analysisMethods": [""]
        },
        {
          "id": "wrist-repeatability",
          "title": "Repeatability",
          "shortDescription": "Positioning consistency in repeatedly commanding the wrist to the same position.",
          "description": "Repeatability is a measure of how accurately the wrist can be repeatedly commanded to the same configuration.",
          "procedures": [""],
          "metrics": [{ "name": "", "unit": "", "description": "" }],
          "analysisMethods": [""]
        },
        {
          "id": "wrist-z-width",
          "title": "Z-Width",
          "shortDescription": "The dynamic range of impedances the wrist can display.",
          "description": "Z-Width measures the dynamic range of mechanical impedance the wrist can display to the environment.",
          "procedures": [""],
          "metrics": [{ "name": "", "unit": "", "description": "" }],
          "analysisMethods": [""]
        }
      ]
    },
    {
      "title": "Finger",
      "description": "",
      "benchmarks": [
        {
          "id": "fingertip-motion-control-bandwidth",
          "title": "Motion Control Bandwidth",
          "shortDescription": "The speed with which the finger's position controller responds to control inputs.",
          "description": "Motion control bandwidth measures how rapidly the fingers' position controller can respond to position commands. It is measured with the finger able to move freely. Control bandwidth can be measured with the finger 'running' [1] and 'waggling'. Running occurs when the sinusoidal joint motions are out of phase, and the fingertip traces a closed loop repeatedly. Waggling occurs when the joint motions are in phase, and the fingertip traces back and forth along a line.",
          "procedures": [""],
          "metrics": [{ "name": "", "unit": "", "description": "" }],
          "analysisMethods": [""],
          "references": ["S. Jacobsen, E. Iversen, D. Knutti, R. Johnson, and K. Biggers, \"Design of the Utah/M.I.T. Dextrous Hand,\" in <em>Proceedings. 1986 IEEE International Conference on Robotics and Automation</em>, San Francisco, CA, USA: IEEE, 1986, pp. 1520–1532. doi: <a href='https://doi.org/10.1109/ROBOT.1986.1087395'>10.1109/ROBOT.1986.1087395</a>."]
        },
        {
          "id": "fingertip-motion-tracking",
          "title": "Motion Tracking",
          "shortDescription": "Position control and sensing accuracy of the finger for sinusoidal position inputs.",
          "description": "Motion tracking measures the finger's position control accuracy. Like the motion control bandwidth test, the finger can execute either a 'running' [1] or 'waggling' motion. Running occurs when the sinusoidal joint motions are out of phase, and the fingertip traces a closed loop repeatedly. Waggling occurs when the joint motions are in phase, and the fingertip traces back and forth along a line. During the test, the position of the fingertip is tracked using vision-based motion capture. The finger position control accuracy is measured using the root-mean-square error (RMSE) between the commanded fingertip position and the externally measured fingertip positions. The position sensing accuracy is also measured using the RMSE between the internally sensed and externally measured fingertip position.",
          "procedures": [""],
          "metrics": [{ "name": "", "unit": "", "description": "" }],
          "analysisMethods": [""],
          "references": ["S. Jacobsen, E. Iversen, D. Knutti, R. Johnson, and K. Biggers, \"Design of the Utah/M.I.T. Dextrous Hand,\" in <em>Proceedings. 1986 IEEE International Conference on Robotics and Automation</em>, San Francisco, CA, USA: IEEE, 1986, pp. 1520–1532. doi: <a href='https://doi.org/10.1109/ROBOT.1986.1087395'>10.1109/ROBOT.1986.1087395</a>."]
        },
        {
          "id": "fingertip-strength",
          "title": "Strength",
          "shortDescription": "The maximum force that can be produced at the fingertip.",
          "description": "Finger strength is the maximum force that the finger can exert at the fingertip when fully extended. Generally, the extended configuration is the weakest configuration for the finger, so the maximum fingertip force in this configuration can be achieved in any other configuration.",
          "procedures": [""],
          "metrics": [{ "name": "", "unit": "", "description": "" }],
          "analysisMethods": [""],
          "references": [
            "J. Falco <em>et al.</em>, \"Benchmarking Protocols for Evaluating Grasp Strength, Grasp Cycle Time, Finger Strength, and Finger Repeatability of Robot End-Effectors,\" <em>IEEE Robot. Autom. Lett.</em>, vol. 5, no. 2, pp. 644–651, Apr. 2020, doi: <a href='https://doi.org/10.1109/LRA.2020.2964164'>10.1109/LRA.2020.2964164</a>.",
            "J. Falco, K. Van Wyk, and E. Messina, \"Performance Metrics and Test Methods for Robotic Hands.\" Oct. 2018. doi: <a href='https://doi.org/10.6028/NIST.SP.1227-draft'>10.6028/NIST.SP.1227-draft</a>.",
            "J. Falco, K. Van Wyk, S. Liu, and S. Carpin, \"Grasping the Performance: Facilitating Replicable Performance Measures via Benchmarking and Standardized Methodologies,\" <em>IEEE Robot. Automat. Mag.</em>, vol. 22, no. 4, pp. 125–136, Dec. 2015, doi: <a href='https://doi.org/10.1109/MRA.2015.2460891'>10.1109/MRA.2015.2460891</a>."
          ]
        },
        {
          "id": "fingertip-speed",
          "title": "Speed",
          "shortDescription": "The maximum speed of the finger.",
          "description": "Finger speed measures the maximum speed that the finger can achieve. It can be measured using the finger cycle time/grasp frequency, maximum joint speeds, or maximum fingertip speed. Here we use cycle time and maximum fingertip speed as joint speed measurements require geometric information about the finger to make fair comparisons with other fingers. In this test, the finger starts fully extended, is commanded to close all the way and a timer is started. Once all the joints have reached their limits, they are commanded to open completely. When the finger reaches the fully extended configuration, the timer is stopped and the time is recorded as the cycle time. During the test, the fingertip position is captured using vision-based motion capture, and the measurements are differentiated to get fingertip velocity. Then, the maximum fingertip speed is extracted from the velocity data.",
          "procedures": [""],
          "metrics": [{ "name": "", "unit": "", "description": "" }],
          "analysisMethods": [""]
        },
        {"_comment": "HIDDEN — moved to Design-Based Benchmarks (other-benchmarks.html); remove _hidden to restore", "_hidden": true,
          "id": "finger-degrees-of-freedom",
          "title": "Degrees of Freedom",
          "shortDescription": "",
          "description": "",
          "procedures": [""],
          "metrics": [{ "name": "", "unit": "", "description": "" }],
          "analysisMethods": [""]
        },
        {
          "id": "finger-joint-backlash",
          "title": "Joint Backlash",
          "shortDescription": "Lost motion caused by clearances in the finger's transmission elements.",
          "description": "Joint backlash measures the clearances in the mechanical transmission that lead to uncontrollable joint motion. This is measured by commanding the actuators to move very slowly while recording the joint angles. Due to the lost motion caused by backlash, the actuators will move slightly before the joints move. The angular motion at the joints lost to backlash is reported as the backlash value.",
          "procedures": [""],
          "metrics": [{ "name": "", "unit": "", "description": "" }],
          "analysisMethods": [""]
        },
        {
          "id": "fingertip-repeatability",
          "title": "Repeatability",
          "shortDescription": "Inconsistency when repeatedly commanding joints to the same position.",
          "description": "Repeatability measures the accuracy with which a finger can repeatedly be commanded to the same configuration. This is measured by moving the finger to follow a trajectory that requires all joints to move, then commanding the finger to return to its original configuration. This is repeated many times, and the root-mean-square error of the deviation between the original and final configuration is reported as the repeatability.",
          "procedures": [""],
          "metrics": [{ "name": "", "unit": "", "description": "" }],
          "analysisMethods": [""],
          "references": [
            "J. Falco <em>et al.</em>, \"Benchmarking Protocols for Evaluating Grasp Strength, Grasp Cycle Time, Finger Strength, and Finger Repeatability of Robot End-Effectors,\" <em>IEEE Robot. Autom. Lett.</em>, vol. 5, no. 2, pp. 644–651, Apr. 2020, doi: <a href='https://doi.org/10.1109/LRA.2020.2964164'>10.1109/LRA.2020.2964164</a>.",
            "J. Falco, K. Van Wyk, and E. Messina, \"Performance Metrics and Test Methods for Robotic Hands.\" Oct. 2018. doi: <a href='https://doi.org/10.6028/NIST.SP.1227-draft'>10.6028/NIST.SP.1227-draft</a>.",
            "J. Falco, K. Van Wyk, S. Liu, and S. Carpin, \"Grasping the Performance: Facilitating Replicable Performance Measures via Benchmarking and Standardized Methodologies,\" <em>IEEE Robot. Automat. Mag.</em>, vol. 22, no. 4, pp. 125–136, Dec. 2015, doi: <a href='https://doi.org/10.1109/MRA.2015.2460891'>10.1109/MRA.2015.2460891</a>."
          ]
        },
        {
          "id": "fingertip-z-width",
          "title": "Z-Width",
          "shortDescription": "The dynamic range of impedances the finger can display.",
          "description": "Z-Width measures the dynamic range of mechanical impedance a finger can display to the environment.",
          "procedures": [""],
          "metrics": [{ "name": "", "unit": "", "description": "" }],
          "analysisMethods": [""]
        }
      ],
      "subsections": [
        {
          "title": "Finger Transparency",
          "description": "",
          "benchmarks": [
            {
              "id": "finger-breakaway-force",
              "title": "Finger Breakaway Force",
              "shortDescription": "The minimum commanded fingertip force that causes motion of the finger. A measure of static friction.",
              "description": "Breakaway force is a measure of mechanical transparency from the actuators to the fingertip that captures static friction. In the forward direction, breakaway force is the minimum commanded fingertip force that causes joint motion. This test is performed with the finger free to move unimpeded, while a slowly ramping force is commanded at the fingertip. The commanded force that causes the finger to move is recorded as the breakaway force.",
