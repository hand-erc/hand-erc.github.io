        {
          "id": "transmission-friction",
          "title": "Friction",
          "shortDescription": "",
          "description": "Transmission friction arises between interfacing surfaces along the transmission path from actuator efforts to the finger links. Stiction in the transmission causes force losses below the transmission breakaway force, while dynamic friction leads to force loss in the transmission. It is possible to compensate for friction with control at the cost of higher control effort. Also, due to the nonlinear behaviors of friction, good friction compensation is difficult to achieve.",
          "procedures": [""],
          "metrics": [{ "name": "", "unit": "", "description": "" }],
          "analysisMethods": [""]
        },
        {
