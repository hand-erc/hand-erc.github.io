        {
          "id": "transmission-stiffness",
          "title": "Transmission Stiffness",
          "shortDescription": "",
          "description": "Transmission stiffness can be reduced by adding elastic elements in series with the actuator and mechanical transmission, making the finger more responsive to the environment. Decreasing transmission stiffness makes the finger more passively responsive, but it also decreases the finger's mechanical bandwidth. Unwanted compliance is introduced to the transmission through gearing compliance, tendon-driven systems, and flexing of structural components.",
          "procedures": [""],
          "metrics": [{ "name": "", "unit": "", "description": "" }],
          "analysisMethods": [""]
        },
