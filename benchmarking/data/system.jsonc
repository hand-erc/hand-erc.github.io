              "link": "https://www.mcmaster.com/76135A1/"
            },
            {
              "item": "Rigid Table",
              "quantity": 1,
              "specification": "Flat rigid work surface capable of holding manipulanda.",
              "link": "https://www.uline.com/Product/Detail/H-6979/Steel-Workbenches/Adjustable-Height-Machine-Table-24-x-18-x-18-25?pricode=WB6636&gadtype=pla&id=H-6979&ad_group_id=150516799157&gad_source=1&gad_campaignid=11612151768&gclid=EAIaIQobChMI2vHI1pKmlQMV_SbUAR01bglwEAQYASABEgLPJvD_BwE"
            }
          ],
          "setup": [
            "Secure the jar vertically to the table using the mounting fixture such that the jar cannot translate or rotate during the task.",
            "Place the lid flat on the tabletop with its open side facing downward and its center approximately 150 mm from the centerline of the jar.",
            "The manipulator shall begin each trial with the nearest point on the end effector at least 100 mm away from all of the manipulanda."
          ],
          "procedures": [
            "Position the manipulator in the prescribed starting configuration.",
            "Grasp and thread the lid until it is fully seated on the jar.",
            "A trial is successful if the lid is properly threaded onto the jar, is fully seated, and remains attached after the manipulator releases contact."
          ],
          "metrics": [
            {
              "name": "Total Task Completion Time",
              "unit": "seconds",
              "description": "Time required to complete the task."
            }
          ],
          "executionConstraints": [
            "Any manipulation strategy may be used.",
            "The task must be completed within 60 seconds."
          ]
        },
        {
          "id": "thread-screw-with-screwdriver",
          "title": "Use Screwdriver",
          "primitiveProfile": {
            "manipulation": "Indirect — tool use",
            "rigidity": "Rigid manipulanda / rigid environment",
            "relativeSize": "Mixed relative to the hand",
            "controlledDegreesOfFreedom": "Moderate — tool pose plus constrained screw motion",
            "constraintComplexity": "High — alignment, axial force, and torque",
            "constraintChange": "High — transport, engagement, and tightening",
            "motionRegime": "Quasistatic"
          },
          "shortDescription": "Use a screwdriver to thread a screw.",
          "configurationImages": [
            { "src": "Images/task_pictures/use_screwdriver/starting.png", "caption": "Starting configuration", "alt": "Screwdriver and partially threaded screw before the task" },
            { "src": "Images/task_pictures/use_screwdriver/intermediate.png", "caption": "Using the screwdriver", "alt": "Screwdriver engaged with the screw" },
            { "src": "Images/task_pictures/use_screwdriver/ending.png", "caption": "Ending configuration", "alt": "Screw after being threaded with the screwdriver" }
          ],
          "description": "Beginning with a partially threaded screw, grasp a screwdriver and use it to thread the screw an additional three turns.",
          "justification": "Use Screwdriver evaluates a system's ability to perform quasistatic indirect manipulation using rigid manipulanda in a rigid environment. The hand-scale screwdriver and smaller screw occupy mixed size categories. Coordinating the tool pose with the screw's constrained motion produces moderate controlled degrees of freedom. The task exhibits high constraint complexity because successful completion requires maintaining tip-to-head alignment, applying axial force and torque, and regulating contact to prevent cam-out. It also involves high constraint change, progressing from free-space tool transport to engagement, threaded insertion, final tightening, and disengagement. More broadly, screwdriver use represents tool-mediated manipulation that is fundamental to manufacturing, maintenance, and assembly.",
          "items": [
            {
              "item": "Phillips-head screwdriver",
              "quantity": 1,
              "specification": "Phillips-head #2 rubber grip screwdriver",
              "link": "https://www.mcmaster.com/5720A53/"
            },
            {
              "item": "Phillips-head screw",
              "quantity": 1,
              "specification": "10-32 steel panhead Phillips-head machine screw",
              "link": "https://www.mcmaster.com/92224A202/"
            },
            {
              "item": "Rigid mounting block with threaded hole",
              "quantity": 1,
              "specification": "Rigid mounting block with 10-32 threaded hole. (e.g., screw mount nut attached to 3D printed block)",
              "link": "https://www.mcmaster.com/90611A340/"
            },
            {
              "item": "Rigid Table",
              "quantity": 1,
              "specification": "Flat rigid work surface capable of holding manipulanda.",
              "link": "https://www.uline.com/Product/Detail/H-6979/Steel-Workbenches/Adjustable-Height-Machine-Table-24-x-18-x-18-25?pricode=WB6636&gadtype=pla&id=H-6979&ad_group_id=150516799157&gad_source=1&gad_campaignid=11612151768&gclid=EAIaIQobChMI2vHI1pKmlQMV_SbUAR01bglwEAQYASABEgLPJvD_BwE"
            }
          ],
          "setup": [
            "Secure the mounting block to the table such that it cannot translate or rotate during the task.",
            "Insert the screw into the threaded hole and thread one complete revolution into the hole.",
            "Place the screwdriver flat on the tabletop approximately 150 mm from the mounting block.",
            "The manipulator shall begin each trial with the nearest point on the end effector at least 100 mm away from all of the manipulanda."
          ],
          "procedures": [
            "Position the manipulator in the prescribed starting configuration.",
            "Grasp the screwdriver and use it to thread the screw three rotations into the threaded hole.",
            "Disengage the screwdriver from the screw.",
            "A trial is successful if the screw has been threaded at least four complete rotations into the threaded hole."
          ],
          "metrics": [
            {
              "name": "Total Task Completion Time",
              "unit": "seconds",
              "description": "Time required to complete the task."
            }
          ],
          "executionConstraints": [
            "Any manipulation strategy may be used, provided the manipulator does not directly contact the screw.",
            "The task must be completed within 60 seconds."
          ]
        },
        {
          "id": "cut-pattern-with-scissors",
          "title": "Use Scissors",
          "primitiveProfile": {
            "manipulation": "Indirect — articulated tool",
            "rigidity": "Mixed manipulanda / rigid environment",
            "relativeSize": "Mixed relative to the hand",
            "controlledDegreesOfFreedom": "High — tool articulation and sheet control",
            "constraintComplexity": "Moderate — path following, blade contact, and material support",
            "constraintChange": "High — repeated blade-material contact",
            "motionRegime": "Quasistatic"
          },
          "shortDescription": "Pick up and use scissors to cut out a circle drawn on a piece of paper.",
          "configurationImages": [
            { "src": "Images/task_pictures/use_scissors/starting.jpg", "caption": "Starting configuration", "alt": "Scissors and marked paper before cutting" },
            { "src": "Images/task_pictures/use_scissors/intermediate.jpg", "caption": "Cutting with scissors", "alt": "Scissors cutting the marked paper" },
            { "src": "Images/task_pictures/use_scissors/ending.jpg", "caption": "Ending configuration", "alt": "Circle cut out from the paper" }
          ],
          "description": "Pick up and use scissors to cut out a circle drawn on a piece of A4 printer paper.",
          "justification": "Use Scissors evaluates a system's ability to perform quasistatic indirect manipulation with mixed rigid and deformable manipulanda in a rigid environment. The hand-scale rigid scissors and larger deformable paper occupy mixed size categories. Tool articulation combined with control of the paper's distributed deformation produces high controlled degrees of freedom. Constraint complexity is moderate: the cut must follow the prescribed path while blade contact and material support are maintained, but the task has no tightly toleranced rigid mating interface. Constraint change is high because blade-paper contacts repeatedly form and break and cutting irreversibly changes the paper's material topology. More broadly, scissor use represents articulated tool manipulation and tool-mediated interaction with deformable objects.",
          "items": [
            {
              "item": "Standard office scissors",
              "quantity": 1,
              "specification": "Standard office scissors",
