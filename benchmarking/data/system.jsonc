{
  "description": [
    "System-Level dexterity benchmarks require high-level integration of the hands with robot arms, vision, control, AI,",
    " possibly teleoperation, and more to complete short-horizon 'atomic' tasks.",
    " The short-horizon nature of system-level tasks enables evaluation of the hand dexterous performance without incorporating details like long-horizon multi-step planning.",
    " These atomic tasks were selected to test different",
    " features of dexterity, emphasizing in-hand manipulation."
  ],
  "sections": [
    {
      "title": "Atomic Benchmarking Tasks",
      "description": "Benchmarks covering a broad range of dexterous abilities.",
      "benchmarks": [
        {
          "id": "box-and-blocks",
          "title": "Box and Blocks",
          "primitiveProfile": {
            "manipulation": "Direct",
            "rigidity": "Rigid objects and environment",
            "relativeSize": "Small relative to the hand",
            "controlledDegreesOfFreedom": "Moderate — multiple independent blocks",
            "constraintComplexity": "Low",
            "constraintChange": "Moderate — grasp, transport, and release",
            "motionRegime": "Quasistatic"
          },
          "shortDescription": "Transfer as many blocks as possible from a cluttered bin to another bin within 60 seconds.",
          "configurationImages": [
            { "src": "Images/task_pictures/box_and_blocks/starting.jpg", "caption": "Starting configuration", "alt": "Blocks arranged in the starting bin" },
            { "src": "Images/task_pictures/box_and_blocks/ending.jpg", "caption": "Ending configuration", "alt": "Blocks transferred into the target bin" }
          ],
          "description": "Starting with blocks in an initial bin, transfer as many blocks as possible over a divider into an adjacent target bin within 60 seconds. This task's setup and procedure are equivalent to Protocol 3a of the YCB Box and Blocks benchmark. Further details on the setup and procedure can be found here.",
          "justification": "Box and Blocks evaluates a system's ability to isolate, grasp, and transport objects from a cluttered environment to a designated target location under time constraints. Although the task involves quasistatic direct manipulation of simple rigid objects with low constraint complexity, high performance still requires reliable grasp acquisition, grasp stability, and efficient object handling, all of which benefit from increased dexterity. Furthermore, object transport serves as a fundamental building block for many more complex manipulation behaviors, which can often be decomposed into sequences of grasp-and-transport actions.",
          "items": [
            {
              "item": "Bins",
              "quantity": 2,
              "specification": "YCB #69",
              "link": "https://www.ycbbenchmarks.com/object-set/"
            },
            {
              "item": "Lid",
              "quantity": 1,
              "specification": "YCB #70",
              "link": "https://www.ycbbenchmarks.com/object-set/"
            },
            {
              "item": "Blocks",
              "quantity": 100,
              "specification": "YCB #71",
              "link": "https://www.ycbbenchmarks.com/object-set/"
            },
            {
              "item": "Rigid Table",
              "quantity": 1,
              "specification": "Flat rigid work surface capable of holding manipulanda.",
              "link": "https://www.uline.com/Product/Detail/H-6979/Steel-Workbenches/Adjustable-Height-Machine-Table-24-x-18-x-18-25?pricode=WB6636&gadtype=pla&id=H-6979&ad_group_id=150516799157&gad_source=1&gad_campaignid=11612151768&gclid=EAIaIQobChMI2vHI1pKmlQMV_SbUAR01bglwEAQYASABEgLPJvD_BwE"
            }
          ],
          "setup": [
            "Arrange items according to the setup diagram shown in the YCB Box and Blocks protocol.",
            "Randomly distribute the blocks in the initial bin.",
            "The manipulation system's end effector must start outside of both bins."
          ],
          "procedures": [
            "Set up the environment as described above.",
            "During a 60-second period, transfer as many blocks as possible from one bin to the other."
          ],
          "metrics": [
            {
              "name": "Number of Blocks Transferred",
              "unit": "blocks",
              "description": "Number of blocks transferred into the target bin."
            }
          ],
          "executionConstraints": [
            "A transfer is successful only if the block crosses the divider before it is released; blocks may not be tossed over the divider.",
            "Transporting multiple blocks simultaneously counts as one block transferred."
          ],
          "protocolLink": "https://www.ycbbenchmarks.com/protocols-and-benchmarks/"
        },
        {
          "id": "peg-in-hole",
          "title": "Peg-in-Hole",
          "primitiveProfile": {
            "manipulation": "Direct",
            "rigidity": "Rigid peg and fixture",
            "relativeSize": "Comparable to the hand",
            "controlledDegreesOfFreedom": "Moderate — precise six-DoF object pose",
            "constraintComplexity": "High — tight position and angle tolerances",
            "constraintChange": "High — free motion to constrained insertion",
            "motionRegime": "Quasistatic"
          },
          "shortDescription": "Insert pegs into a pegboard with holes of various shapes and tolerances.",
          "configurationImages": [
            { "src": "Images/task_pictures/peg_in_hole/starting.jpg", "caption": "Starting configuration", "alt": "NIST assembly task board before assembly" },
            { "src": "Images/task_pictures/peg_in_hole/ending.jpg", "caption": "Ending configuration", "alt": "NIST assembly task board after assembly" }
          ],
          "description": "Insert pegs into the NIST Assembly Task Board M1 with holes of various shapes and tolerances. This task's setup and procedure are equivalent to a single round of ManipulationNet's peg insertion task. Further details on the setup and procedure can be found here.",
          "justification": "Peg-in-Hole evaluates a system's ability to perform precision assembly under tight geometric tolerances. The task involves quasistatic direct manipulation of a rigid object whose size is comparable to that of the hand. The task exhibits high constraint complexity, since successful completion depends on satisfying multiple geometric constraints simultaneously while operating within narrow positional and angular tolerances. It also features significant constraint change, as the interaction progresses from unconstrained free-space motion to increasingly restrictive contact conditions as the peg enters the hole. More broadly, peg insertion serves as a canonical example of contact-rich assembly and is representative of a wide range of industrial manufacturing operations.",
          "items": [
            {
              "item": "NIST Assembly Task Board M1",
              "quantity": 1,
              "specification": "NIST Assembly Task Board M1",
              "link": "https://manipulation-net.org/tasks/peg_in_hole.html"
            },
            {
              "item": "Pegs",
              "quantity": 5,
              "specification": "Corresponding circle, hexagon, triangle, rectangle and L-shape pegs",
              "link": "https://manipulation-net.org/tasks/peg_in_hole.html"
            },
            {
              "item": "Peg Holder",
              "quantity": 1,
              "specification": "Corresponding Peg-holder",
              "link": "https://manipulation-net.org/tasks/peg_in_hole.html"
            },
            {
              "item": "Rigid Table",
              "quantity": 1,
              "specification": "Flat rigid work surface capable of holding manipulanda.",
              "link": "https://www.uline.com/Product/Detail/H-6979/Steel-Workbenches/Adjustable-Height-Machine-Table-24-x-18-x-18-25?pricode=WB6636&gadtype=pla&id=H-6979&ad_group_id=150516799157&gad_source=1&gad_campaignid=11612151768&gclid=EAIaIQobChMI2vHI1pKmlQMV_SbUAR01bglwEAQYASABEgLPJvD_BwE"
            }
          ],
          "setup": [
            "Place both the assembly task board and peg holder on the table in any preferred configuration."
          ],
          "procedures": [
            "Place the pegs and pegboard in the prescribed starting positions, then select a pegboard row, numbered 1 through 4, to fill.",
            "Grasp the peg whose shape corresponds to the target hole.",
            "Align and insert the peg into the target hole.",
            "Repeat for all five peg-hole pairs. The insertion order is A(n), B(n), C(n), D(n), E(n)."
          ],
          "metrics": [
            {
              "name": "Pegs Inserted",
              "unit": "pegs",
              "description": "Number of pegs successfully inserted."
            }
          ],
          "executionConstraints": [
            "Any manipulation strategy may be used.",
            "The task must be completed within three hours."
          ],
          "protocolLink": "https://manipulation-net.org/tasks/peg_in_hole.html"
        },
        {
          "id": "pick-up-flat-object",
          "title": "Pick Up Flat Object",
          "primitiveProfile": {
            "manipulation": "Direct",
            "rigidity": "Rigid object and support",
            "relativeSize": "Much smaller than the hand",
            "controlledDegreesOfFreedom": "Low — one rigid object",
            "constraintComplexity": "High — support restricts grasp access",
            "constraintChange": "Moderate — table contact to hand support",
            "motionRegime": "Quasistatic"
          },
          "shortDescription": "Stably grasp an M6 washer initially lying flat on a rigid table.",
          "configurationImages": [
            { "src": "Images/task_pictures/grasp_flat_object/starting.jpg", "caption": "Starting configuration", "alt": "Washer lying flat on the table" },
            { "src": "Images/task_pictures/grasp_flat_object/ending.jpg", "caption": "Ending configuration", "alt": "Washer lifted above the table" }
          ],
          "description": "Grasp and lift an M6 washer initially resting flat on a rigid tabletop to a specified height without dropping it.",
          "justification": "Pick Up Flat Object evaluates a system's ability to acquire and maintain a stable grasp on a thin object resting on a supporting surface. The task involves quasistatic direct manipulation of a rigid object whose dimensions are substantially smaller than those of the hand, requiring precise fingertip placement and careful coordination during grasp acquisition. Unlike many object relocation tasks, the supporting surface significantly restricts access to the object, increasing constraint complexity by limiting feasible contact locations and grasp approaches. Successful completion often requires managing changing contact conditions as the object transitions from table contact to hand support, introducing moderate constraint change throughout the grasping process. More broadly, grasping thin objects is representative of many real-world manipulation scenarios involving washers, coins, cards, sheets, and other low-profile objects that are challenging to isolate from supporting surfaces.",
          "items": [
            {
              "item": "M6 washer",
              "quantity": 1,
              "specification": "Stainless Steel M6 Washer.",
              "link": "https://www.mcmaster.com/91701A621/"
            },
            {
              "item": "Rigid Table",
              "quantity": 1,
              "specification": "Flat rigid work surface capable of holding manipulanda.",
              "link": "https://www.uline.com/Product/Detail/H-6979/Steel-Workbenches/Adjustable-Height-Machine-Table-24-x-18-x-18-25?pricode=WB6636&gadtype=pla&id=H-6979&ad_group_id=150516799157&gad_source=1&gad_campaignid=11612151768&gclid=EAIaIQobChMI2vHI1pKmlQMV_SbUAR01bglwEAQYASABEgLPJvD_BwE"
            }
          ],
          "setup": [
            "Place the washer flat on the tabletop near the center of the table.",
            "The manipulator shall begin each trial with the nearest point on the end effector at least 100 mm away from the washer."
          ],
          "procedures": [
            "Position the manipulator in the prescribed starting configuration.",
            "Transport the washer to a height of at least 2 cm above the tabletop.",
            "Maintain control of the washer for a minimum of 3 seconds while keeping it stationary and above the required height.",
            "A trial is successful if the washer is lifted to the required height and remains stationary within the target region for the allotted time."
          ],
          "metrics": [
            {
              "name": "Total Task Completion Time",
              "unit": "seconds",
              "description": "Time required to complete the task."
            }
          ],
          "executionConstraints": [
            "Any method may be used to grasp, lift, and hold the washer at the required height.",
            "The task must be completed within 60 seconds."
          ]
        },
        {
          "id": "tie-a-knot",
          "title": "Tie a Knot",
          "primitiveProfile": {
            "manipulation": "Direct",
            "rigidity": "Deformable rope; rigid environment",
            "relativeSize": "Thin relative to the hand",
            "controlledDegreesOfFreedom": "High — continuously deformable rope",
            "constraintComplexity": "High — contact and topological constraints",
            "constraintChange": "High — evolving contacts and topology",
            "motionRegime": "Primarily quasistatic"
          },
          "shortDescription": "Tie a rope into a tight overhand knot.",
          "configurationImages": [
            { "src": "Images/task_pictures/tie_a_knot/starting.jpg", "caption": "Starting configuration", "alt": "Untied rope on the table" },
            { "src": "Images/task_pictures/tie_a_knot/ending.jpg", "caption": "Ending configuration", "alt": "Rope tied in an overhand knot" }
          ],
          "description": "Tie a rope into a tight overhand knot.",
          "justification": "Tie a Knot evaluates a system's ability to manipulate deformable objects whose geometry changes continuously throughout the task. The task involves direct manipulation of a flexible rope with some dimensions that are small relative to the hand and whose effective number of controllable degrees of freedom is substantially greater than that of rigid objects. Unlike rigid-body manipulation tasks, successful completion requires coordinating a sequence of intermediate configurations while controlling both the global shape and local contacts of the string. In addition, knot formation requires satisfying topological constraints that do not arise in conventional assembly tasks. While the task is primarily quasistatic, successful execution demands precise contact management, and adaptation to continuously changing object geometry. More broadly, knot tying serves as a representative benchmark for deformable-object manipulation and captures many of the challenges encountered when handling ropes, cables, sutures, and other flexible materials.",
          "items": [
            {
              "item": "rope",
              "quantity": 1,
              "specification": "50 cm long 1/4 in diameter low stretch polyester plastic rope.",
              "link": "https://www.mcmaster.com/3132T131/"
            },
            {
              "item": "Rigid Table",
              "quantity": 1,
              "specification": "Flat rigid work surface capable of holding manipulanda.",
              "link": "https://www.uline.com/Product/Detail/H-6979/Steel-Workbenches/Adjustable-Height-Machine-Table-24-x-18-x-18-25?pricode=WB6636&gadtype=pla&id=H-6979&ad_group_id=150516799157&gad_source=1&gad_campaignid=11612151768&gclid=EAIaIQobChMI2vHI1pKmlQMV_SbUAR01bglwEAQYASABEgLPJvD_BwE"
            }
          ],
          "setup": [
            "Place the rope near the center of the table in any configuration that does not self-intersect.",
            "The manipulator shall begin each trial with the nearest point on the end effector at least 100 mm away from all of the manipulanda."
          ],
          "procedures": [
            "Position the manipulator in the prescribed starting configuration.",
            "Manipulate the rope to tie an overhand knot.",
            "Release the tied rope onto the table.",
            "A trial is successful if a valid overhand knot remains intact after release with no visible slack in the knot."
          ],
          "metrics": [
            {
              "name": "Total Task Completion Time",
              "unit": "seconds",
              "description": "Time required to complete the task."
            }
          ],
          "executionConstraints": [
            "Any manipulation strategy may be used.",
            "The task must be completed within 60 seconds."
          ]
        },
        {
          "id": "twist-lid-on-jar",
          "title": "Twist Lid on Jar",
          "primitiveProfile": {
            "manipulation": "Direct",
            "rigidity": "Rigid lid, jar, and environment",
            "relativeSize": "Comparable to the hand",
            "controlledDegreesOfFreedom": "Moderate — translation, alignment, and rotation",
            "constraintComplexity": "High — threaded alignment and torque",
            "constraintChange": "High — free motion to thread engagement",
            "motionRegime": "Quasistatic"
          },
          "shortDescription": "Pick up a regular mouth round jar lid from a table and thread and tighten it onto a fixed jar.",
          "configurationImages": [
            { "src": "Images/task_pictures/twist_lid/starting.jpg", "caption": "Starting configuration", "alt": "Jar and detached lid in their starting positions" },
            { "src": "Images/task_pictures/twist_lid/ending.jpg", "caption": "Ending configuration", "alt": "Lid threaded onto the jar" }
          ],
          "description": "Pick up a regular mouth round jar lid from a table and thread and tighten it onto a fixed jar.",
          "justification": "Twist a Lid on Jar evaluates a system's ability to perform contact-rich assembly involving both translational and rotational manipulation. The task involves quasistatic direct manipulation of a rigid object whose dimensions are comparable to those of the hand and requires sequentially coordinating object relocation, alignment, and in-hand manipulation. The task exhibits substantial constraint complexity, since successful completion depends on satisfying geometric constraints imposed by the threaded interface while simultaneously maintaining a stable grasp and applying sufficient torque. It also involves significant constraint change, as the interaction progresses from unconstrained free-space motion to initial contact, thread engagement, and eventually fully constrained rotational tightening. More broadly, lid threading is representative of a wide range of household and industrial assembly operations that require alignment, insertion, and controlled application of rotational forces.",
          "items": [
            {
              "item": "jar lid",
              "quantity": 1,
              "specification": "89-400 regular-mouth round plastic jar lid",
              "link": "https://www.uline.com/Product/Detail/S-9936/Jars/Clear-Round-Wide-Mouth-Plastic-Jars-16-oz-White-Cap?pricode=WB0644&gadtype=pla&id=S-9936&ad_group_id=152179486982&gad_source=1&gad_campaignid=11612151543&gclid=Cj0KCQjwguLSBhDLARIsAH-yPrELFzXivNndELEB9E2T3k6Yjjk5g-u3pHuzmfw575vte0hAn15mJ2IaArQNEALw_wcB"
            },
            {
              "item": "Regular-mouth jar",
              "quantity": 1,
              "specification": "Any plastic jar that is compatible with the lid",
              "link": "https://www.uline.com/Product/Detail/S-9936/Jars/Clear-Round-Wide-Mouth-Plastic-Jars-16-oz-White-Cap?pricode=WB0644&gadtype=pla&id=S-9936&ad_group_id=152179486982&gad_source=1&gad_campaignid=11612151543&gclid=Cj0KCQjwguLSBhDLARIsAH-yPrELFzXivNndELEB9E2T3k6Yjjk5g-u3pHuzmfw575vte0hAn15mJ2IaArQNEALw_wcB"
            },
            {
              "item": "Rigid mounting fixture",
              "quantity": 1,
              "specification": "Any fixture that secures the jar in all six degrees of freedom in the prescribed starting configuration (e.g., tape).",
              "link": "https://www.mcmaster.com/76135A1/"
            },
            {
              "item": "Rigid Table",
              "quantity": 1,
              "specification": "Flat rigid work surface capable of holding manipulanda.",
              "link": "https://www.uline.com/Product/Detail/H-6979/Steel-Workbenches/Adjustable-Height-Machine-Table-24-x-18-x-18-25?pricode=WB6636&gadtype=pla&id=H-6979&ad_group_id=150516799157&gad_source=1&gad_campaignid=11612151768&gclid=EAIaIQobChMI2vHI1pKmlQMV_SbUAR01bglwEAQYASABEgLPJvD_BwE"
            }
          ],
          "setup": [
            "Secure the jar vertically to the table using the mounting fixture such that the jar cannot translate or rotate during the task.",
            "Place the lid flat on the tabletop with its open side facing downward and its center approximately 150 mm from the centerline of the jar.",
            "The manipulator shall begin each trial with the nearest point on the end effector at least 100 mm away from all of the manipulanda."
          ],
          "procedures": [
            "Position the manipulator in the prescribed starting configuration.",
            "Grasp and thread the lid until it is fully seated on the jar.",
            "A trial is successful if the lid is properly threaded onto the jar, is fully seated, and remains attached after the manipulator releases contact."
          ],
          "metrics": [
            {
              "name": "Total Task Completion Time",
              "unit": "seconds",
              "description": "Time required to complete the task."
            }
          ],
          "executionConstraints": [
            "Any manipulation strategy may be used.",
            "The task must be completed within 60 seconds."
          ]
        },
        {
          "id": "thread-screw-with-screwdriver",
          "title": "Use Screwdriver",
          "primitiveProfile": {
            "manipulation": "Indirect — tool use",
            "rigidity": "Rigid tool, screw, and environment",
            "relativeSize": "Hand-scale tool; small screw",
            "controlledDegreesOfFreedom": "High — tool pose and screw interaction",
            "constraintComplexity": "High — alignment, axial force, and torque",
            "constraintChange": "High — transport, engagement, and tightening",
            "motionRegime": "Quasistatic"
          },
          "shortDescription": "Use a screwdriver to thread a screw.",
          "configurationImages": [
            { "src": "Images/task_pictures/use_screwdriver/starting.png", "caption": "Starting configuration", "alt": "Screwdriver and partially threaded screw before the task" },
            { "src": "Images/task_pictures/use_screwdriver/intermediate.png", "caption": "Using the screwdriver", "alt": "Screwdriver engaged with the screw" },
            { "src": "Images/task_pictures/use_screwdriver/ending.png", "caption": "Ending configuration", "alt": "Screw after being threaded with the screwdriver" }
          ],
          "description": "Beginning with a partially threaded screw, grasp a screwdriver and use it to thread the screw an additional three turns.",
          "justification": "Use Screwdriver evaluates a system's ability to perform quasistatic indirect manipulation of a rigid object through the use of a tool. Relative to direct assembly tasks, screwdriver use introduces additional degrees of freedom associated with grasping, orienting, and stabilizing the tool while simultaneously controlling its interaction with the screw. The task exhibits high constraint complexity, as successful completion requires maintaining alignment between the screwdriver tip and screw head, generating sufficient torque to advance the screw, and regulating contact forces to prevent the driver head from camming out. It also involves substantial constraint change, progressing from free-space tool transport to tool engagement, threaded insertion, and final tightening. More broadly, screwdriver use serves as a representative benchmark for tool use and indirect manipulation, capabilities that are fundamental to many manufacturing, maintenance, and assembly operations.",
          "items": [
            {
              "item": "Phillips-head screwdriver",
              "quantity": 1,
              "specification": "Phillips-head #2 rubber grip screwdriver",
              "link": "https://www.mcmaster.com/5720A53/"
            },
            {
              "item": "Phillips-head screw",
              "quantity": 1,
              "specification": "10-32 steel panhead Phillips-head machine screw",
              "link": "https://www.mcmaster.com/92224A202/"
            },
            {
              "item": "Rigid mounting block with threaded hole",
              "quantity": 1,
              "specification": "Rigid mounting block with 10-32 threaded hole. (e.g., screw mount nut attached to 3D printed block)",
              "link": "https://www.mcmaster.com/90611A340/"
            },
            {
              "item": "Rigid Table",
              "quantity": 1,
              "specification": "Flat rigid work surface capable of holding manipulanda.",
              "link": "https://www.uline.com/Product/Detail/H-6979/Steel-Workbenches/Adjustable-Height-Machine-Table-24-x-18-x-18-25?pricode=WB6636&gadtype=pla&id=H-6979&ad_group_id=150516799157&gad_source=1&gad_campaignid=11612151768&gclid=EAIaIQobChMI2vHI1pKmlQMV_SbUAR01bglwEAQYASABEgLPJvD_BwE"
            }
          ],
          "setup": [
            "Secure the mounting block to the table such that it cannot translate or rotate during the task.",
            "Insert the screw into the threaded hole and thread one complete revolution into the hole.",
            "Place the screwdriver flat on the tabletop approximately 150 mm from the mounting block.",
            "The manipulator shall begin each trial with the nearest point on the end effector at least 100 mm away from all of the manipulanda."
          ],
          "procedures": [
            "Position the manipulator in the prescribed starting configuration.",
            "Grasp the screwdriver and use it to thread the screw three rotations into the threaded hole.",
            "Disengage the screwdriver from the screw.",
            "A trial is successful if the screw has been threaded at least four complete rotations into the threaded hole."
          ],
          "metrics": [
            {
              "name": "Total Task Completion Time",
              "unit": "seconds",
              "description": "Time required to complete the task."
            }
          ],
          "executionConstraints": [
            "Any manipulation strategy may be used, provided the manipulator does not directly contact the screw.",
            "The task must be completed within 60 seconds."
          ]
        },
        {
          "id": "cut-pattern-with-scissors",
          "title": "Use Scissors",
          "primitiveProfile": {
            "manipulation": "Indirect — articulated tool",
            "rigidity": "Rigid tool; deformable paper",
            "relativeSize": "Hand-scale tool; larger sheet",
            "controlledDegreesOfFreedom": "High — tool articulation and sheet control",
            "constraintComplexity": "High — cutting path, contact, and material control",
            "constraintChange": "High — repeated blade-material contact",
            "motionRegime": "Quasistatic"
          },
          "shortDescription": "Pick up and use scissors to cut out a circle drawn on a piece of paper.",
          "configurationImages": [
            { "src": "Images/task_pictures/use_scissors/starting.jpg", "caption": "Starting configuration", "alt": "Scissors and marked paper before cutting" },
            { "src": "Images/task_pictures/use_scissors/intermediate.jpg", "caption": "Cutting with scissors", "alt": "Scissors cutting the marked paper" },
            { "src": "Images/task_pictures/use_scissors/ending.jpg", "caption": "Ending configuration", "alt": "Circle cut out from the paper" }
          ],
          "description": "Pick up and use scissors to cut out a circle drawn on a piece of A4 printer paper.",
          "justification": "Use Scissors evaluates a system's ability to perform indirect quasistatic manipulation through an articulated tool while interacting with a deformable object. The task requires manipulating a pair of scissors whose dimensions are comparable to those of the hand while simultaneously controlling the motion and deformation of a sheet of paper. Relative to direct manipulation tasks, scissor use introduces additional degrees of freedom associated with the tool's articulation and coordination between the tool and the material being cut. More broadly, scissor use serves as a representative benchmark for articulated tool manipulation and tool-mediated interaction with deformable objects, capabilities that are important in manufacturing, medical, and household manipulation tasks.",
          "items": [
            {
              "item": "Standard office scissors",
              "quantity": 1,
              "specification": "Standard office scissors",
