            }
          ],
          "setup": [
            "Before each trial, randomly select an initial orientation and a target orientation, expressed as Euler angles with respect to a global frame.",
            "At least one Euler angle of the target orientation must differ from the initial orientation by 90 degrees or more.",
            "Place the rectangular prism in a stable grasp within the hand at the initial orientation."
          ],
          "procedures": [
            "Position the manipulator with the object in the prescribed initial grasp and orientation.",
            "Reorient the object from the initial orientation to the specified target orientation using only in-hand manipulation.",
            "Hold the object within the target orientation tolerance for at least 2 seconds.",
            "A trial is successful if the object does not contact the environment and remains within the target orientation tolerance (5 degrees about each axis) for 2 seconds at the end of the trial."
          ],
          "metrics": [
            {
              "name": "Total Task Completion Time",
              "unit": "seconds",
              "description": "Time required to complete the task."
            }
          ],
          "executionConstraints": [
            "Any manipulation strategy may be used, provided the rectangular prism does not contact the environment.",
            "The task must be completed within 60 seconds."
          ]
